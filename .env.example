# Monad
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
PULSE_TRADE_STAMP=0x6eC692C5792AD122c459AC8Df3FDF67eE80842F4

# Signing — never commit a real key. Live stamp spends testnet MON.
PRIVATE_KEY=
PULSE_DRY_RUN=true
# Set to 1 (or pass --live) to broadcast stamp() after the audit line.
PULSE_STAMP_LIVE=

# Agent
PULSE_AGENT_ID=pulse-demo
PULSE_DATA_DIR=./data

# Native TypeSafe Jev soft gate (optional). Alias: JEV_API_KEY.
# Never commit a real key. Unset = stub (CI-safe).
TYPESAFE_API_KEY=
JEV_API_KEY=
# Optional: default https://api.typesafe.ai/v1/systemone
# Vercel (or other) gateway: set to that host's /v1/systemone path.
TYPESAFE_JEV_URL=
TYPESAFE_JEV_MODEL=jev-latest
TYPESAFE_JEV_THRESHOLD=0.5

CMC_API_KEY=
KRONOS_SIDECAR_URL=

# Optional ERC-8004 identity shell (no live mint required)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_AGENT_URI=
ERC8004_AGENT_WALLET=
ERC8004_AGENT_ID=
